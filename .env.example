# Backend Environment
NODE_ENV=production
PORT=3077
HOST=0.0.0.0

# Host Configuration - Ändern Sie diese Werte für Ihr System
APP_HOST=YOUR_SERVER_IP_OR_HOSTNAME
FRONTEND_PORT=3078
BACKEND_PORT=3077

# HTTPS Certificate (Build)
CERTIFICATE_CN=YOUR_SERVER_IP_OR_HOSTNAME
CERTIFICATE_PASSWORD=your-strong-certificate-password

# Database
DATABASE_URL=file:./data/bekleidung.db

# Microsoft Entra ID Configuration
# Erstellen Sie eine App-Registrierung in Azure Portal
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_REDIRECT_URI=https://YOUR_SERVER_IP:3078/auth/callback
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# JWT Configuration
# Generieren Sie einen sicheren, zufälligen String (min. 32 Zeichen)
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Email Configuration (SMTP)
# Verwenden Sie Ihre SMTP-Zugangsdaten
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Your App Name <your-email@yourdomain.com>"

# Email Mode Configuration
# Optionen:
# - development: Alle Emails gehen an TEST_EMAIL_ADDRESS (zum Testen)
# - production: Emails gehen an echte Mitarbeiter-Adressen
EMAIL_MODE=development
TEST_EMAIL_ADDRESS=test@yourdomain.com
